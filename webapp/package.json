{
  "name": "dnd-bot-webapp",
  "private": true,
  "version": "2.14.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-silhouette-manifest.mjs",
    "build": "tsc && vite build",
    "build:prod": "node scripts/build-prod.mjs",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:homebrew:audit": "playwright test --config=playwright.homebrew.config.ts --reporter=./tests/e2e-playwright/homebrew/audit-reporter.ts"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tanstack/react-query": "^5.56.2",
    "@types/canvas-confetti": "^1.9.0",
    "cannon-es": "^0.20.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^11.11.0",
    "i18next": "^23.15.1",
    "lucide-react": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-icons": "^5.6.0",
    "react-router-dom": "^6.26.2",
    "react-zoom-pan-pinch": "^3.7.0",
    "sonner": "^1.5.0",
    "three": "^0.160.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "canvas": "^3.2.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
